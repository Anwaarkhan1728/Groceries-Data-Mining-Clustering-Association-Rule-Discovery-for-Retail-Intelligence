# Group items by member and date to create baskets
baskets = df.groupby(['Member_number', 'Date'])['itemDescription'].apply(list).values.tolist()
print("Number of baskets:", len(baskets))
print("Sample basket:", baskets[0])


# Encode baskets into binary matrix
te = TransactionEncoder()
te_array = te.fit(baskets).transform(baskets)
df_encoded = pd.DataFrame(te_array, columns=te.columns_)
print("Encoded shape:", df_encoded.shape)
df_encoded.head()


# Member-level features for clustering
member_features = df.groupby('Member_number').agg(
    total_items=('itemDescription', 'count'),
    unique_items=('itemDescription', 'nunique'),
    num_transactions=('Date', 'nunique'),
    avg_basket_size=('itemDescription', lambda x: x.count() / df.loc[x.index, 'Date'].nunique())
).reset_index()

# Add category-based features
# Define some common categories
categories = {
    'dairy': ['milk', 'yogurt', 'cream', 'cheese', 'butter'],
    'bakery': ['bread', 'rolls', 'buns', 'pastry', 'cake'],
    'meat': ['beef', 'chicken', 'pork', 'sausage', 'ham'],
    'produce': ['vegetables', 'fruit', 'onions', 'potatoes', 'tomatoes'],
    'beverages': ['juice', 'water', 'soda', 'coffee', 'tea'],
    'snacks': ['chips', 'cookies', 'candy', 'chocolate', 'nuts'],
    'household': ['detergent', 'soap', 'cleaner', 'paper', 'bags']
}

for cat, keywords in categories.items():
    pattern = '|'.join(keywords)
    member_features[f'cat_{cat}'] = df[df['Member_number'].isin(
        df[df['itemDescription'].str.contains(pattern, case=False, na=False)]['Member_number']
    )].groupby('Member_number').size().reindex(member_features['Member_number']).fillna(0).values

print(member_features.head())
